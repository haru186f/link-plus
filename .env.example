# ============================================================
# Django 環境設定テンプレート (.env.example)
# ============================================================
# このファイルはチーム全員で共有します。
# 実際の値はここに書かず、各自がコピーして使用してください。
#
# mac / Linux:
#     cp .env.example .env.development
#
# Windows (PowerShell):
#     copy .env.example .env.development
#
# その後、自分の環境に合わせて .env.development を編集してください。
# ============================================================


# ------------------------------------------------------------
# 🔐 セキュリティ設定
# ------------------------------------------------------------
# Django SECRET_KEY は各自で生成する
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# ------------------------------------------------------------
# 🗄️ データベース設定 (PostgreSQL 共通)
# ------------------------------------------------------------
POSTGRES_DB=linkplus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------
# ✉️ メール設定（必要に応じて設定）
# ------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
